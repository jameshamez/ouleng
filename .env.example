# Copy to .env.local. Leave a block empty to keep using demo mode for that part.

# --- Supabase (Project Settings → API). Server-only; never expose the service key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LINE Login channel (for LIFF). Endpoint URL of the LIFF app: https://<your-domain>/liff
NEXT_PUBLIC_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=

# --- LINE Messaging API channel (the shop's LINE OA)
LINE_CHANNEL_ACCESS_TOKEN=
# Group ID of the staff LINE group the OA bot was invited to
LINE_STAFF_GROUP_ID=

# --- Shop
PROMPTPAY_ID=0836544414
# Random string (e.g. `openssl rand -base64 32`). Changing it re-keys every table QR.
STAFF_SESSION_SECRET=
STAFF_PIN_SOMTAM=
STAFF_PIN_CAFE=
STAFF_PIN_CASHIER=
STAFF_PIN_ADMIN=
